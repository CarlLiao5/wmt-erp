NODE_ENV=development
PORT=3000
COOKIE_SECRET=replace-with-at-least-32-random-characters
# Generate a private 32-byte key with: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=replace-with-private-32-byte-key
MYSQL_URL=mysql://walmart:walmart_dev@127.0.0.1:3306/walmart_erp
REDIS_URL=redis://127.0.0.1:6379
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=walmart-erp
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
WALMART_CLIENT_ID=replace-with-sandbox-client-id
WALMART_CLIENT_SECRET=replace-with-sandbox-client-secret
WALMART_ENVIRONMENT=sandbox
