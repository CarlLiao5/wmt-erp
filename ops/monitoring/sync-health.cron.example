# Install as /etc/cron.d/walmart-erp-sync-health after replacing the user.
# The env file must be root-readable only: chmod 600 /etc/walmart-erp/sync-health.env
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Every 15 minutes; flock prevents overlapping checks.
*/15 * * * * root flock -n /run/lock/walmart-erp-sync-health.lock /opt/walmart-erp/ops/monitoring/run-sync-health-check.sh >>/var/log/walmart-erp-sync-health.log 2>&1
